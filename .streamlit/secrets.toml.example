# Copy to `secrets.toml` in this folder (ignored by git) for local `streamlit run`,
# or paste these keys into Streamlit Community Cloud → App settings → Secrets.

ODDS_API_KEY = "paste_the_odds_api_key_here"

# Optional proxies — same convention as Unix env vars. Requests expects the PROXY SERVER
# URL to use the http:// scheme even for HTTPS traffic (urllib3 CONNECT tunnel).
# HTTP_PROXY = "http://proxy.company.com:8080"
# HTTPS_PROXY = "http://proxy.company.com:8080"

# Bypass tunnel for NBA / local when the MITM proxy returns 403 for stats.nba.com.
# NO_PROXY = "stats.nba.com,.nba.com,localhost,127.0.0.1"
