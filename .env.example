# Copy to `.env` and adjust. Requests / nba_api read proxy vars from the environment
# after this file is loaded by `env_bootstrap` (imported by fetch_data, predict_next_games,
# fetch_box_scores, odds_provider). Shell-exported variables override these.

# ODDS_API_KEY=

# Corporate proxy (use http:// even for HTTPS outbound — typical for MITM proxies).
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Skip proxy for NBA / local (helps when the proxy tunnels fail with 403).
# NO_PROXY=stats.nba.com,.nba.com,localhost,127.0.0.1
