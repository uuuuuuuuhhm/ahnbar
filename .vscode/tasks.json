{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Daily pipeline (default)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["jobs/daily.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Daily pipeline (nightly profile)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["jobs/daily.py", "--profile", "nightly"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Daily pipeline (skip fetch + nightly)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["jobs/daily.py", "--skip-fetch", "--profile", "nightly"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
